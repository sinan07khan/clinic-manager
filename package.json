{
  "name": "clinic-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "clean": "node -e \"const fs = require('fs'); ['.next', 'release', 'dist'].forEach(d => fs.existsSync(d) && fs.rmSync(d, { recursive: true, force: true }));\"",
    "package:release": "node scripts/package-release.js",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
